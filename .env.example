POSTGRES_DB=nodeflow
POSTGRES_USER=nodeflow
POSTGRES_PASSWORD=replace-with-a-long-random-password
PANEL_ADMIN_TOKEN=replace-with-at-least-32-random-characters
PANEL_PORT=8080
PANEL_BIND_ADDR=127.0.0.1
# Required only for a deliberate direct non-loopback plain-HTTP publication.
# Keep false when using an SSH tunnel or host Nginx/Caddy HTTPS proxy.
ALLOW_INSECURE_HTTP=false
# External browser origin terminated by the host reverse proxy. This also keeps
# browser session cookies Secure even though the container upstream is HTTP.
PANEL_PUBLIC_URL=https://panel.example.com
DATABASE_MAX_CONNS=25

# Dedicated outbound Agent -> Panel mTLS channel. Replace 192.0.2.10 with the
# stable Panel address used in the server certificate SAN.
PANEL_AGENT_PUBLIC_URL=https://192.0.2.10:4200
PANEL_AGENT_TLS_LISTEN_ADDR=:4200
PANEL_AGENT_TLS_BIND_ADDR=192.0.2.10
PANEL_AGENT_TLS_PORT=4200
PANEL_AGENT_TLS_CERT_FILE=/tls/server.crt
PANEL_AGENT_TLS_KEY_FILE=/tls/server.key
PANEL_AGENT_TLS_CLIENT_CA_FILE=/pki/ca.crt
PANEL_AGENT_TLS_ISSUER_KEY_FILE=/pki/ca.key
PANEL_REQUIRE_AGENT_MTLS=true
# Development without the dedicated TLS listener must opt out explicitly with
# PANEL_REQUIRE_AGENT_MTLS=false. Production defaults to fail-closed mTLS.

# Generated by scripts/init-mtls-pki.sh.
PANEL_UPDATE_SIGNING_KEY_FILE=/pki/update-signing.key

# Prometheus /metrics (disabled by default). Token >= 32 chars; optional comma-separated allowlist.
PANEL_METRICS_ENABLED=false
PANEL_METRICS_TOKEN=
PANEL_METRICS_ALLOW_CIDRS=
