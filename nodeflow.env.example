# NodeFlow Panel environment for compose.release.yaml (prebuilt ghcr.io image).
# install.sh fills every CHANGE-ME value automatically. For a manual install
# copy this file to .env next to compose.yaml, chmod 600 it and replace the
# placeholders (openssl rand -hex 24 / -hex 32).

# Panel image tag (ghcr.io/nodeflow-dev/nodeflow-panel:<NODEFLOW_VERSION>).
NODEFLOW_VERSION=2.0.0

POSTGRES_DB=nodeflow
POSTGRES_USER=nodeflow
POSTGRES_PASSWORD=CHANGE-ME-postgres-password
PANEL_ADMIN_TOKEN=CHANGE-ME-admin-token-at-least-32-characters

# Browser HTTP upstream. Keep it on loopback: Caddy/Nginx on the host serves
# HTTPS and proxies to 127.0.0.1:8080.
PANEL_PORT=8080
PANEL_BIND_ADDR=127.0.0.1
ALLOW_INSECURE_HTTP=false
PANEL_PUBLIC_URL=https://panel.example.com
DATABASE_MAX_CONNS=10

# Direct Agent -> Panel mTLS listener. The certificate in tls/ must carry the
# host of PANEL_AGENT_PUBLIC_URL in its SAN (install.sh generates it).
PANEL_AGENT_PUBLIC_URL=https://panel.example.com:4200
PANEL_AGENT_TLS_LISTEN_ADDR=:4200
PANEL_AGENT_TLS_BIND_ADDR=0.0.0.0
PANEL_AGENT_TLS_PORT=4200
PANEL_AGENT_TLS_CERT_FILE=/tls/server.crt
PANEL_AGENT_TLS_KEY_FILE=/tls/server.key
PANEL_AGENT_TLS_CLIENT_CA_FILE=/pki/ca.crt
PANEL_AGENT_TLS_ISSUER_KEY_FILE=/pki/ca.key
PANEL_REQUIRE_AGENT_MTLS=true
PANEL_UPDATE_SIGNING_KEY_FILE=/pki/update-signing.key

# Prometheus /metrics (disabled by default). Token >= 32 chars; optional
# comma-separated source allowlist.
PANEL_METRICS_ENABLED=false
PANEL_METRICS_TOKEN=
PANEL_METRICS_ALLOW_CIDRS=
