NODE_AGENT_LISTEN=127.0.0.1:4200
# Keep false. Remote plaintext management requires a deliberate opt-in.
NODE_AGENT_ALLOW_REMOTE_LISTEN=false
NODE_AGENT_TOKEN=replace-with-a-long-random-token
NODE_AGENT_HAPROXY_CONFIG=/etc/haproxy/haproxy.cfg
NODE_AGENT_HAPROXY_BINARY=/usr/sbin/haproxy
NODE_AGENT_HAPROXY_SERVICE=haproxy.service
NODE_AGENT_HAPROXY_STATS_SOCKET=/run/haproxy/admin.sock
NODE_AGENT_HAPROXY_STATS_TIMEOUT=2s
# Local safety ceiling. Keep observe unless UFW is active, sshd has an allow
# safeguard, and the service unit grants CAP_NET_ADMIN plus /etc/ufw writes.
# The Panel SSH bootstrap or scripts/prepare-node-firewall.sh handles the UFW
# preparation; the manual install script adjusts the unit when set to apply.
NODE_AGENT_FIREWALL_MODE=observe
NODE_AGENT_SELF_UPDATE_MODE=off
# Set apply only together with the Panel Ed25519 public key and updater service.
# NODE_AGENT_UPDATE_STAGING_DIR=/var/lib/nodeflow/updates
# NODE_AGENT_UPDATE_PUBLIC_KEY=base64-ed25519-public-key
# NODE_AGENT_UPDATE_SEQUENCE=0
# NODE_AGENT_UPDATE_STATE_FILE=/var/lib/nodeflow-updater/state.json
# NODE_AGENT_UPDATE_PENDING_FILE=/var/lib/nodeflow/updates/pending.json
# NODE_AGENT_UPDATE_RESULT_FILE=/var/lib/nodeflow/updates/result.json
# NODE_AGENT_UPDATE_HELPER_SERVICE=nodeflow-node-updater.service
NODE_AGENT_PANEL_URL=https://panel.example:4200
NODE_AGENT_PANEL_TLS_CA=/etc/nodeflow/tls/ca.crt
NODE_AGENT_PANEL_TLS_CERT=/etc/nodeflow/tls/node.crt
NODE_AGENT_PANEL_TLS_KEY=/etc/nodeflow/tls/node.key
# NODE_AGENT_PANEL_TLS_SERVER_NAME=panel.example
NODE_AGENT_HEARTBEAT_INTERVAL=15s
NODE_AGENT_RECONCILE_TIMEOUT=45s
