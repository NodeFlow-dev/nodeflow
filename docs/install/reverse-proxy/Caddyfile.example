# Replace panel.example.com. Caddy obtains and renews the public certificate.
panel.example.com {
    encode zstd gzip

    request_body {
        max_size 70MB
    }

    reverse_proxy 127.0.0.1:8080 {
        header_up Host {host}
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-Proto https
    }
}
